{
  "manifest_version": 2,
  "name": "ccfox",
  "version": "0.6.0",
  "description": "Claude Code in your Zen/Firefox side panel, and browser control for Claude Code. Runs your local Claude Code; nothing listens on the network.",
  "browser_specific_settings": {
    "gecko": {
      "id": "ccfox@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "<all_urls>",
    "nativeMessaging",
    "webRequest",
    "webNavigation",
    "storage"
  ],
  "background": {
    "scripts": [
      "chat.js",
      "highlight.js",
      "workflow.js",
      "background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_title": "ccfox",
    "default_icon": "icons/icon.svg"
  },
  "sidebar_action": {
    "default_title": "ccfox",
    "default_panel": "sidebar/panel.html",
    "default_icon": "icons/icon.svg",
    "open_at_install": false
  },
  "commands": {
    "_execute_sidebar_action": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Open or close the ccfox side panel"
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  }
}
