{
  "manifest_version": 2,
  "name": "ccfox",
  "version": "0.7.0",
  "description": "Claude Code in your Zen/Firefox side panel, and browser control for Claude Code. Needs the ccfox helper and Claude Code installed on your computer. Unofficial; not made by Anthropic.",
  "author": "thedankest",
  "homepage_url": "https://github.com/thedankest/ccfox",
  "browser_specific_settings": {
    "gecko": {
      "id": "ccfox@thedankest",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent",
          "browsingActivity",
          "websiteActivity",
          "personalCommunications"
        ]
      }
    }
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "<all_urls>",
    "nativeMessaging",
    "webRequest",
    "webNavigation",
    "storage"
  ],
  "incognito": "not_allowed",
  "background": {
    "scripts": [
      "chat.js",
      "highlight.js",
      "workflow.js",
      "js-exec.js",
      "background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_title": "ccfox",
    "default_icon": "icons/icon.svg"
  },
  "sidebar_action": {
    "default_title": "ccfox",
    "default_panel": "sidebar/panel.html",
    "default_icon": "icons/icon.svg",
    "open_at_install": false
  },
  "commands": {
    "_execute_sidebar_action": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Open or close the ccfox side panel"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  }
}
